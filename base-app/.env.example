# Copy to .env (gitignored). NEVER put real keys in a tracked file.
# --- client (only VITE_* reach the browser bundle) ---
VITE_APP_NAME=Base app
VITE_API_BASE=/api
# --- dev ports ---
WEB_PORT=5173
# Who answers page requests: dist (production: the built server render), dev (Vite inside the server, on
# WEB_PORT), off (API only). Unset: dist in production, dev otherwise.
# SSR_MODE=dev
# --- sign-in ---
# Development (npm run dev) seeds a fixed, PUBLIC dev login: admin@example.test / adminpassword.
# It is shown on the sign-in page and works in development only. Production refuses to start
# without its own ADMIN_PASSWORD (12+ characters, not the dev one) and seeds no demo data.
# Uncomment to override the dev login, and set both for production:
# ADMIN_EMAIL=you@yourcompany.com
# ADMIN_PASSWORD=
SESSION_TTL_HOURS=168
# Secure cookies need https. Default: on in production, off in development.
# COOKIE_SECURE=true
# --- links in emails, uploads ---
# The public address of the app: the origin of the links in invite and password-reset emails
# (no path). Development defaults to http://localhost:$WEB_PORT; production must set it.
# APP_BASE_URL=https://app.example.com
# Where uploaded files (avatars) are stored on disk. Back it up with the database. Default:
# UPLOADS_DIR=./data/uploads
# --- server ---
# Defaults shown commented, so `docker run --env-file .env` keeps the image's own values.
# API_HOST=127.0.0.1
# API_PORT=8787
# Extra origins allowed to POST (the app's own origins are always allowed):
# ALLOWED_ORIGINS=https://app.example.com
# Open beyond loopback (containers only): ALLOW_NON_LOOPBACK=true and PUBLIC_HOSTS=name1,name2
# sqlite::memory: | sqlite:./.data/app.sqlite | postgres://user:pass@host:5432/db | mysql://user:pass@host:3306/db
DATABASE_URL=sqlite::memory:
# The local containers (npm run db:up; compose.yaml, dev-only passwords). `npm run dev:pg` and
# `npm run dev:mysql` set DATABASE_URL for you; use these lines to point `npm run dev` at one yourself:
# DATABASE_URL=postgres://app:app_dev_only@127.0.0.1:5432/app
# DATABASE_URL=mysql://app:app_dev_only@127.0.0.1:3306/app
# Ports of the containers (default 5432 and 3306, loopback only):
# POSTGRES_PORT=5432
# MYSQL_PORT=3306
# --- mail and links ---
# Where people reach the app: links in emails (invitations, password resets) are built on it.
# Development defaults to http://localhost:<WEB_PORT>. Required in production (https).
# APP_BASE_URL=https://app.example.com
# log (the development default): emails are recorded, not sent; read them at Admin -> Mail.
# resend: send through Resend. Production must choose one of the two explicitly.
# MAIL_TRANSPORT=log
# RESEND_API_KEY=
# The From header. Required in production with resend (a domain verified with Resend).
# MAIL_FROM=Base app <no-reply@example.com>
# --- background jobs ---
# JOBS_POLL_MS=1000
# JOBS_CONCURRENCY=4
# On SIGTERM, how long running jobs get to finish before the process exits:
# JOBS_SHUTDOWN_GRACE_MS=10000
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_FALLBACKS=default
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
LLM_TIMEOUT_MS=120000
# optional: run the database suites on Postgres and MySQL. `npm run test:db` sets these for you.
# They name a database the user may CREATE DATABASE from; each test makes and drops its own.
# TEST_POSTGRES_URL=postgres://app:app_dev_only@127.0.0.1:5432/app_test
# TEST_MYSQL_URL=mysql://app:app_dev_only@127.0.0.1:3306/app_test
TEST_POSTGRES_URL=
TEST_MYSQL_URL=
