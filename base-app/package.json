{
  "name": "@apps/base-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The template app: export it to a folder of its own to start a new app (README.md).",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "vendor/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/main.ts",
    "dev:web": "vite",
    "dev:api": "SSR_MODE=off node --env-file-if-exists=.env --watch server/main.ts",
    "start:api": "SSR_MODE=off node --env-file-if-exists=.env server/main.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "vercel-build": "vite build && node server/cli/migrate.ts --deploy",
    "preview": "vite preview",
    "typecheck": "tsc -p . && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:db": "node scripts/db.mjs test",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:reset": "node scripts/db.mjs reset",
    "db:psql": "node scripts/db.mjs psql",
    "db:mysql": "node scripts/db.mjs mysql",
    "dev:pg": "node scripts/db.mjs dev pg",
    "dev:mysql": "node scripts/db.mjs dev mysql",
    "check": "biome check . && oxlint && npm run check:colours && npm run check:pages && npm run check:craft && npm run check:headers && npm run check:ignore",
    "check:colours": "node scripts/check-colours.mjs --no-legacy",
    "check:pages": "node scripts/check-pages.mjs --strict",
    "check:craft": "node scripts/check-craft.mjs --strict",
    "check:headers": "node scripts/vercel-headers.mjs --check",
    "check:ignore": "node scripts/check-ignore-files.mjs",
    "check:deps": "node scripts/check-release-age.mjs",
    "check:a11y": "vitest run --project web -t a11y",
    "check:a11y:browser": "node scripts/a11y-browser.mjs",
    "check:budget": "vite build && node scripts/check-budget.ts",
    "check:perf:glass": "node scripts/perf-glass.mjs",
    "format": "biome format --write .",
    "verify": "npm run check && npm run check:deps && npm run typecheck && npm run test && npm run check:a11y && npm run check:budget",
    "export": "node scripts/export.mjs",
    "start": "npm run build && NODE_ENV=production node --env-file-if-exists=.env server/main.ts",
    "serve": "NODE_ENV=production node --env-file-if-exists=.env server/main.ts",
    "db:migrate": "node --env-file-if-exists=.env server/cli/migrate.ts --apply",
    "db:verify": "node --env-file-if-exists=.env server/cli/migrate.ts --verify"
  },
  "dependencies": {
    "@apps/colors": "0.1.0",
    "@apps/ui": "0.1.0",
    "mysql2": "3.24.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "jsdom": "30.1.3",
    "oxlint": "1.88.0",
    "playwright-core": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
